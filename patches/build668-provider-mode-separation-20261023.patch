+package tr.borsatakip.v5.data
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MarketModePolicyTest {
+    @Test fun noBackendDoesNotDisableDelayedBistObservation() {
+        assertEquals(MarketModePolicy.BistSource.LOCAL_DELAYED_OBSERVATION, MarketModePolicy.bistSource(false, false))
+        assertTrue(MarketModePolicy.delayedBistUserMessage().contains("Gecikmeli BIST"))
+        assertFalse(MarketModePolicy.canClaimAuthorizedViop(false, false))
+    }
+    @Test fun missingApiKeyCannotClaimAuthorizedScan() {
+        assertEquals(MarketModePolicy.BistSource.LOCAL_DELAYED_OBSERVATION, MarketModePolicy.bistSource(true, false))
+        assertFalse(MarketModePolicy.canClaimAuthorizedViop(true, false))
+    }
+    @Test fun configuredBackendStillRequiresIndependentVerification() {
+        assertEquals(MarketModePolicy.BistSource.PRODUCTION_PREFLIGHT_REQUIRED, MarketModePolicy.bistSource(true, true))
+        assertFalse(MarketModePolicy.canClaimAuthorizedViop(true, false))
+        assertTrue(MarketModePolicy.canClaimAuthorizedViop(true, true))
+    }
+    @Test fun viopSuccessNeverClaimsBistVerified() {
+        assertEquals("VİOP TESTİ GEÇTİ", MarketModePolicy.settingsWorkMode(true, true))
+        assertEquals("YETKİLİ TEST GEREKLİ", MarketModePolicy.settingsWorkMode(false, true))
+        assertEquals("BIST GECİKMELİ MOD", MarketModePolicy.settingsWorkMode(false, false))
+        assertEquals("BIST GECİKMELİ MOD", MarketModePolicy.settingsWorkMode(true, false))
+    }
+}
