+package tr.borsatakip.v5.data
+
+/**
+ * Capability labels are deliberately separate from upstream reachability.
+ * An unconfigured HTTPS backend cannot disable user-triggered delayed BIST observation.
+ * A successful VİOP probe cannot certify live BIST symbols, candles or trading signals.
+ */
+object MarketModePolicy {
+    enum class BistSource { PRODUCTION_PREFLIGHT_REQUIRED, LOCAL_DELAYED_OBSERVATION }
+
+    fun bistSource(validHttpsConfigured: Boolean, apiKeyPresent: Boolean): BistSource =
+        if (validHttpsConfigured && apiKeyPresent) BistSource.PRODUCTION_PREFLIGHT_REQUIRED
+        else BistSource.LOCAL_DELAYED_OBSERVATION
+
+    /** A provider capability, NOT a statement that Yahoo is reachable or that data exists. */
+    fun delayedBistUserMessage(): String =
+        "Gecikmeli BIST gözlemi denenebilir. Veri ve sembol kapsamı doğrulanmadan tarama başarılı sayılamaz; canlı AL/SAT veya VİOP sinyali üretilmez."
+
+    fun settingsWorkMode(viopVerified: Boolean, backendConfigured: Boolean): String = when {
+        viopVerified && backendConfigured -> "VİOP TESTİ GEÇTİ"
+        backendConfigured -> "YETKİLİ TEST GEREKLİ"
+        else -> "BIST GECİKMELİ MOD"
+    }
+
+    /** Only a separately verified authorized provider can make a real VİOP contract claim. */
+    fun canClaimAuthorizedViop(backendConfigured: Boolean, viopQuoteVerified: Boolean): Boolean =
+        backendConfigured && viopQuoteVerified
+}
