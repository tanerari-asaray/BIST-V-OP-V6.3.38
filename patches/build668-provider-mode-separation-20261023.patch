+package tr.borsatakip.v5.data
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.io.File
+
+class Build668ProviderModesSourceContractTest {
+    private fun ui(name: String) = File("src/main/java/tr/borsatakip/v5/ui/$name").readText()
+    private fun worker(name: String) = File("src/main/java/tr/borsatakip/v5/worker/$name").readText()
+    @Test fun unconfiguredViopCannotHideLocalDelayedBist() {
+        val src = ui("SettingsActivity.kt")
+        assertTrue(src.contains("MarketModePolicy.delayedBistUserMessage()"))
+        assertTrue(src.contains("EXTRA_LOCAL_DELAYED_MODE, true"))
+        assertTrue(src.contains("VİOP sağlayıcı ön kontrolü doğrulandı"))
+        assertFalse(src.contains("setBadge(workBadge, \"CANLI VERİ\""))
+    }
+    @Test fun manualAndAutomaticBistUseSameIndependentModeGate() {
+        assertTrue(ui("BistScanActivity.kt").contains("MarketModePolicy.bistSource("))
+        assertTrue(worker("AutomaticScanRunner.kt").contains("MarketModePolicy.bistSource("))
+        assertTrue(ui("BistScanActivity.kt").contains("BistScanMode.DELAYED_ANALYSIS"))
+        assertTrue(worker("AutomaticScanRunner.kt").contains("BistScanMode.DELAYED_ANALYSIS"))
+    }
+    @Test fun realViopIsNeverFabricatedFromDelayedBist() {
+        val s = ui("ViopActivity.kt")
+        assertTrue(s.contains("ProviderState.PROVIDER_NOT_CONFIGURED"))
+        assertTrue(s.contains("DAYANAK MODU"))
+        assertTrue(s.contains("VİOP fiyatı üretilmedi"))
+    }
+}
