+package tr.borsatakip.v5.data
+
+/**
+ * Local delayed BIST observation is independent of a licensed production backend.
+ * Authorization for a full BIST/VIOP attempt requires a valid HTTPS endpoint and
+ * a non-empty API key, but this *local preflight* never claims a live VIOP feed.
+ */
+object ObservationModeReadinessPolicy {
+    enum class Mode { LOCAL_DELAYED_BIST, AUTHORIZED_BIST_VIOP }
+    data class Decision(val mayStart: Boolean, val mode: Mode, val message: String)
+
+    fun check(localMode: Boolean, baseUrl: String, apiKey: String): Decision {
+        if (localMode) return Decision(true, Mode.LOCAL_DELAYED_BIST,
+            "Yalnız gecikmeli BIST teknik gözlemi; VİOP ve canlı işlem onayı yok.")
+        if (!BackendUrlPolicy.isValid(baseUrl)) return Decision(false, Mode.AUTHORIZED_BIST_VIOP,
+            "Yetkili BIST/VİOP taraması için geçerli HTTPS backend gerekir. Gecikmeli BIST gözlemini ayrıca açabilirsiniz.")
+        if (apiKey.isBlank()) return Decision(false, Mode.AUTHORIZED_BIST_VIOP,
+            "Yetkili BIST/VİOP taraması için API anahtarı gerekir. Gecikmeli BIST gözlemini ayrıca açabilirsiniz.")
+        return Decision(true, Mode.AUTHORIZED_BIST_VIOP,
+            "Yetkili bağlantı yerel olarak yapılandırıldı; canlı VİOP ve veri yetkisi henüz doğrulanmadı.")
+    }
+}
