+package tr.borsatakip.v5.analysis
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.io.File
+import tr.borsatakip.v5.data.ObservationModeReadinessPolicy
+import tr.borsatakip.v5.data.ObservationModeReadinessPolicy.Mode
+
+/** Regression tests against false full-universe claims when provider is absent. */
+class Build668ProviderModeSeparationTest {
+    @Test fun delayedBistCanRunWithoutProductionBackend() {
+        val d = ObservationModeReadinessPolicy.check(true, "", "")
+        assertTrue(d.mayStart)
+        assertEquals(Mode.LOCAL_DELAYED_BIST, d.mode)
+        assertTrue(d.message.contains("VİOP"))
+    }
+
+    @Test fun authorizedFullScanCannotRunWithoutHttpsOrApiKey() {
+        assertFalse(ObservationModeReadinessPolicy.check(false, "", "").mayStart)
+        assertFalse(ObservationModeReadinessPolicy.check(false, "http://localhost:8080", "key").mayStart)
+        assertFalse(ObservationModeReadinessPolicy.check(false, "https://example.org", "").mayStart)
+    }
+
+    @Test fun configuredEndpointStillDoesNotClaimLicencedLiveProvider() {
+        val d = ObservationModeReadinessPolicy.check(false, "https://example.org", "key")
+        assertTrue(d.mayStart)
+        assertEquals(Mode.AUTHORIZED_BIST_VIOP, d.mode)
+        assertTrue(d.message.contains("doğrulanmadı"))
+    }
+
+    @Test fun runtimeAndUiBothUseIndependentAuthorizationGate() {
+        val root = File("src/main/java/tr/borsatakip/v5/ui")
+        val runtime = File(root, "FullUniverseScanRuntime.kt").readText()
+        val activity = File(root, "FullUniverseScanActivity.kt").readText()
+        val settings = File(root, "SettingsActivity.kt").readText()
+        assertTrue(runtime.contains("ObservationModeReadinessPolicy.check(localMode"))
+        assertTrue(runtime.contains("if (!modeGate.mayStart)"))
+        assertTrue(activity.contains("GECİKMELİ BIST MODU"))
+        assertTrue(settings.contains("EXTRA_LOCAL_DELAYED_MODE, true"))
+        assertTrue(settings.contains("canlı VİOP verisi veya AL/SAT onayı sağlamaz"))
+    }
+}
