--- a/android-v6323/app/src/test/java/tr/borsatakip/v5/analysis/Build668LargeFontOverflowContractTest.kt
+++ b/android-v6323/app/src/test/java/tr/borsatakip/v5/analysis/Build668LargeFontOverflowContractTest.kt
@@ -0,0 +1,30 @@
+package tr.borsatakip.v5.analysis
+
+import org.junit.Assert.*
+import org.junit.Test
+import java.io.File
+
+/** Guards visual fixes verified on Android 15 at 360dp width and 1.3x font scale. */
+class Build668LargeFontOverflowContractTest {
+    private val technical by lazy { File("src/main/res/layout/activity_technical_analysis.xml").readText() }
+    private val stockLayout by lazy { File("src/main/res/layout/activity_stock_detail.xml").readText() }
+    private val stockActivity by lazy { File("src/main/java/tr/borsatakip/v5/ui/StockDetailActivity.kt").readText() }
+
+    @Test fun technicalTabsHaveRoomForTwoLinesAtLargeFontScale() {
+        for (id in listOf("techTabIndicators", "techTabPattern", "techTabLevels")) {
+            val section = technical.substringAfter("android:id=\"@+id/$id\"").substringBefore("android:text=")
+            assertTrue("$id must fit two lines", section.contains("android:layout_height=\"64dp\""))
+            assertTrue("$id must allow two lines", section.contains("android:maxLines=\"2\""))
+            assertTrue("$id must center text", section.contains("android:gravity=\"center\""))
+        }
+    }
+
+    @Test fun delayedSourceNameIsNotTruncatedMidWord() {
+        assertFalse("Do not cut Yahoo Finance metadata mid-word", stockActivity.contains("source.take(30)"))
+        assertTrue(stockActivity.contains("source.substringBefore(\" • \")"))
+        assertTrue(stockActivity.contains("Kaynak: \$provider"))
+        assertTrue(stockLayout.contains("android:id=\"@+id/quoteSource\""))
+        val source = stockLayout.substringAfter("android:id=\"@+id/quoteSource\"").substringBefore("</LinearLayout>")
+        assertTrue(source.contains("android:maxLines=\"5\""))
+    }
+}
