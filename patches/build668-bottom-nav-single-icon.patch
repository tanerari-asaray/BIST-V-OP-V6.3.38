+package tr.borsatakip.v5.analysis
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.File
+
+class Build668BottomNavSingleIconRegressionTest {
+    @Test fun marketScreensRenderOneVectorIconAndOneLabel() {
+        val xml = File("src/main/res/layout/include_bottom_nav.xml").readText()
+        val ui = File("src/main/java/tr/borsatakip/v5/ui/MarketScreenUi.kt").readText()
+        assertTrue(xml.contains("android:drawableTop=\"@drawable/ic_sd_nav_home\""))
+        assertTrue(xml.contains("android:drawableTop=\"@drawable/ic_sd_nav_stocks\""))
+        assertTrue(ui.contains("R.id.navHome to \"Ana Sayfa\""))
+        assertTrue(ui.contains("text = label"))
+        assertFalse(ui.contains("SpannableString(label)"))
+        assertFalse(ui.contains("label.substringAfter('\n')"))
+    }
+}
