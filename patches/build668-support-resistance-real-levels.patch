+    private fun drawVerifiedLevels(canvas: Canvas, left: Float, right: Float, top: Float, bottom: Float,
+                                   minPrice: Double, maxPrice: Double, y: (Double) -> Float) {
+        val levels = supportResistance ?: return
+        fun render(level: ChartSupportResistance.Level?, line: Paint, band: Paint, text: Paint, prefix: String) {
+            val value = level?.price ?: return
+            if (!value.isFinite() || value <= 0.0 || value !in minPrice..maxPrice) return
+            val middle = y(value)
+            val upper = y(value + levels.bandHalfWidth).coerceIn(top, bottom)
+            val lower = y(value - levels.bandHalfWidth).coerceIn(top, bottom)
+            canvas.save()
+            canvas.clipRect(left, top, right, bottom)
+            canvas.drawRect(left, min(upper, lower), right, max(upper, lower), band)
+            canvas.drawLine(left, middle, right, middle, line)
+            val kind = if (level.evidence == ChartSupportResistance.Evidence.CONFIRMED_PIVOT) "pivot" else "40 mum sınırı"
+            val label = "$prefix ${"%.2f".format(value)} · $kind"
+            val textY = (middle - 5f).coerceIn(top + text.textSize, bottom - 3f)
+            // Label stays in the plot and never intrudes into the right-hand price axis.
+            if (text.measureText(label) < right - left - 8f) canvas.drawText(label, left + 4f, textY, text)
+            canvas.restore()
+        }
+        render(levels.resistance, resistanceLevelPaint, resistanceBandPaint, resistanceLabelPaint, "DİRENÇ")
+        render(levels.support, supportLevelPaint, supportBandPaint, supportLabelPaint, "DESTEK")
     }
 
